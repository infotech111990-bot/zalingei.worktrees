APP_NAME="University of Zalingei"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# If your local site is served from a subfolder, set the full URL including that folder.
# For shared hosting/cPanel, point the document root to the project's public/ directory and omit /public from APP_URL.

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zalingei
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@zalingei.edu.sd"
MAIL_FROM_NAME="${APP_NAME}"
