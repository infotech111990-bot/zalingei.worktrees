{
    "name": "zalingei/university-website",
    "description": "University of Zalingei website - modernized Laravel application",
    "keywords": [
        "laravel",
        "university",
        "zalingei"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2|^8.3",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "nesbot/carbon": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "files": [
            "app/mtCPanelHelpers.php"
        ],
        "classmap": [
            "database/seeders",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "audit": {
            "block-insecure": false
        }
    }
}
